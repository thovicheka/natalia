      "Bash(rclone purge:*)",
      "Bash(rclone sync:*)",
      "Bash(prefect deployment run:*)",
      "Bash(uv run prefect deployment run:*)",
      "Bash(.venv/bin/prefect deployment run:*)",
      "Bash(prefect flow-run resume:*)",
      "Bash(uv run prefect flow-run resume:*)",
      "Bash(.venv/bin/prefect flow-run resume:*)",
      "Bash(*prefect deployment run*)",
      "Bash(*prefect flow-run resume*)",
      "Bash(*run_deployment*)",
      "Bash(*resume_flow_run*)",
      "Bash(*/deployments/*/create_flow_run*)",
      "Bash(*/flow_runs/*/resume*)",
      "Bash(*prefect deployment delete*)",
      "Bash(*prefect work-pool delete*)",
      "Bash(*prefect work-pool pause*)"
    ]
