      "Bash(git push*:main*)",
      "Bash(git push*refs/heads/main*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push* --force*)",
      "Bash(git push* -f*)",
      "Bash(git push* +*)",
      "Bash(git push* --mirror*)",
      "Bash(git push* --delete*)",
      "Bash(git push* -d *)",
      "Bash(git merge:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr*)",
      "Bash(rm -Rf*)",
      "Bash(rm -fR*)",
      "Bash(rm -r*)",
      "Bash(rm -R*)",
      "Bash(rm -f -r*)",
      "Bash(rm --recursive*)",
      "Bash(rm * -r*)",
      "Bash(rm * -R*)",
      "Bash(rm * -fr*)",
      "Bash(find *-delete*)",
      "Read(./.env)",
      "Read(**/.env)",
      "Read(~/**/.env)",
      "Read(//**/.env)",
      "Edit(**/.env)",
      "Edit(~/**/.env)",
      "Write(**/.env)",
      "Write(~/**/.env)",
      "Bash(cat .env:*)",
      "Bash(*python*'.env*)",
      "Bash(*python*\".env*)",
      "Bash(*python*/.env*)",
      "Bash(cp *.env*)",
      "Bash(mv *.env*)",
      "Edit(~/projects/cloud-ai-lab/**)",
