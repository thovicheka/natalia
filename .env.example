# Copy to .env (git-ignored) and fill in real values: cp .env.example .env && chmod 600 .env
# Never commit .env.

# Which LLM natalia/llm.py uses: anthropic (default) or gemini (task 1.7)
LLM_PROVIDER=anthropic

# Anthropic API (Claude Haiku 5.5), prepaid credits with auto-reload off (task 1.7).
# Key from platform.claude.com. Paid per token: real calls only with the human's approval.
ANTHROPIC_API_KEY=sk-ant-fake-anthropic-api-key

# Google Gemini API, free tier (task 1.6). Key from aistudio.google.com; no billing needed.
# Only used with LLM_PROVIDER=gemini (the project answered 403 on 2026-10-16).
# The free tier may use prompts to improve Google's models: never send private data.
GEMINI_API_KEY=fake-gemini-api-key

# PostgreSQL + pgvector on this server, localhost only (task 1.2)
DATABASE_URL=postgresql://natalia:fake-password@127.0.0.1:5432/natalia

# Embedding model, run locally on CPU (task 1.5 confirms or replaces it)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Natalia's own Telegram bot (task 1.8), NOT the cloud-ai-lab alert bot.
# Token from @BotFather; chat IDs from @userinfobot
TELEGRAM_BOT_TOKEN=123456789:fake-bot-token
TELEGRAM_OWNER_CHAT_ID=123456789
# Comma-separated chat IDs allowed to use the bot (the owner plus family and friends, task 2.1)
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321

# Shared Prefect server from cloud-ai-lab (not a secret)
PREFECT_API_URL=http://127.0.0.1:4200/api
